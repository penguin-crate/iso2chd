#!/bin/bash

VERSION="1.1.0"
AUTHOR="Abhimanyu Bhadauriya"

show_help() {
    cat << HELP
iso2chd - Batch ISO to CHD conversion utility
Author: $AUTHOR

USAGE:
    iso2chd [DIRECTORY]
    iso2chd [OPTION]

DESCRIPTION:
    Interactively or automatically scans a target directory for .iso files,
    converts them to .chd format using chdman (DVD mode), and removes source files upon success.

OPTIONS:
    -h, --help        Show this help message and exit
    -v, --version     Show version information and exit

EXAMPLES:
    iso2chd                   # Prompts for directory input
    iso2chd /mnt/ps2games     # Converts ISOs in /mnt/ps2games
    iso2chd ~/Downloads/ISOs  # Converts ISOs expanding home directory
HELP
}

# Parse options
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo "iso2chd version $VERSION by $AUTHOR"
        exit 0
        ;;
esac

echo "iso2chd v$VERSION by $AUTHOR"
echo "-----------------------------------"

TARGET_DIR="$1"

# Interactive fallback
if [ -z "$TARGET_DIR" ]; then
    read -rp "Enter the directory you want to scan (press Enter for current dir): " TARGET_DIR
fi

# Default to current directory if blank
TARGET_DIR="${TARGET_DIR:-.}"

# Safely expand tilde ~ to $HOME
TARGET_DIR="${TARGET_DIR/\~/$HOME}"

# Validate directory existence
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi

cd "$TARGET_DIR" || exit 1
echo "Processing .iso files in: $(pwd)"

# Process files
found_iso=false
for f in *.iso; do
    [ -f "$f" ] || continue
    found_iso=true
    echo "Compressing: $f"

    # Swapped to createdvd for proper DVD/PS2 disc compression
    if chdman createdvd -i "$f" -o "${f%.iso}.chd"; then
        echo "Successfully converted $f. Removing source ISO..."
        rm "$f"
    else
        echo "Error compressing $f. Keeping source file." >&2
    fi
done

if [ "$found_iso" = false ]; then
    echo "No .iso files found in $(pwd)."
else
    echo "Batch compression complete!"
fi
